@{
    ViewData["Title"] = "Change Password";
}
<div class="section-title">Change Password</div>
<p style="color:#555;margin-bottom:16px;">
    Users authenticated via Active Directory must change their password in AD.
    Contact ICT Support if you need assistance.
</p>
<div class="panel-box">
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label class="form-label">Current Password</label>
            <div class="form-control-wrap">
                <input type="password" name="currentPassword" />
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">New Password</label>
            <div class="form-control-wrap">
                <input type="password" name="newPassword" />
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">Confirm Password</label>
            <div class="form-control-wrap">
                <input type="password" name="confirmPassword" />
            </div>
        </div>
        <div class="button-row">
            <button type="submit" class="btn btn-save">Submit</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-cancel">Cancel</a>
        </div>
    </form>
</div>
